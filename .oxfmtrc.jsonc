{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "experimentalSortImports": {
    "newlinesBetween": false,
  },
  "experimentalSortPackageJson": {
    "sortScripts": true,
  },
  "tabWidth": 2,
  "useTabs": false,
  "ignorePatterns": [
    "apps/",
    "assets/",
    "CLAUDE.md",
    "docker-compose.yml",
    "dist/",
    "docs/_layouts/",
    "node_modules/",
    "patches/",
    "pnpm-lock.yaml/",
    "src/gateway/server-methods/CLAUDE.md",
    "src/auto-reply/reply/export-html/",
    "Swabble/",
    "vendor/",
    // Synced verbatim from Ohio15/dev-standards by the guard re-sync; formatting them
    // here would be overwritten (and re-break format:check) on the next re-sync.
    ".github/workflows/dep-auto-apply.yml",
    ".github/workflows/security-audit.yml",
    ".gitleaks.toml",
    "SECURITY-CHECKS.md",
    // Generated by extensions/intelligence/benchmark/train-classifier.ts (compact JSON).
    "extensions/intelligence/benchmark/classifier-model.json",
  ],
}
